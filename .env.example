# Publicas. Astro solo expone al navegador las que empiezan con PUBLIC_.

# Pixel de Meta. Si se deja vacia se usa el de prueba 1042412788159075.
PUBLIC_META_PIXEL_ID=1042412788159075

# Captcha: turnstile (por defecto), recaptcha o none.
PUBLIC_CAPTCHA_PROVIDER=turnstile
PUBLIC_TURNSTILE_SITE_KEY=
PUBLIC_RECAPTCHA_SITE_KEY=

PUBLIC_REQUIRE_COOKIE_CONSENT=true

# Solo si el formulario debe apuntar a otro endpoint. Por defecto /api/lead.
PUBLIC_LEAD_ENDPOINT=

# ---------------------------------------------------------------------------
# Privadas. Las lee la funcion en functions/api/lead.js, nunca el navegador.
# En Cloudflare Pages van marcadas como "Encrypt".
# ---------------------------------------------------------------------------

CRM_EMAIL=jkamalcars@ledas.neoverify.com
MAIL_FROM=
MAIL_REPLY_TO=

RESEND_API_KEY=
MAILGUN_API_KEY=
MAILGUN_DOMAIN=

LEAD_FORWARD_URL=

# Origen del lead que Neo muestra como Referral Source / Source Detail.
# Para Meta: Facebook / Feyth Marketing. Para Google: cambiar a Google.
LEAD_SOURCE=Facebook
LEAD_SOURCE_DETAIL=Feyth Marketing

# Leads de prueba: abrir la landing con ?jk_test=1 y enviar el formulario.
# El ADF llega rotulado "TEST LEAD — marcar como DEAD" para que Neo lo distinga.
# No es una variable: es un parametro de URL. Se documenta aqui como recordatorio.

TURNSTILE_SECRET_KEY=
RECAPTCHA_SECRET_KEY=
CAPTCHA_MIN_SCORE=0.5
