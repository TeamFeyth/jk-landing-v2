# Publicas. Astro solo expone al navegador las que empiezan con PUBLIC_.

# Pixel de Meta. Ya NO hay valor por defecto: si se deja vacia, el pixel no
# carga. Es intencional; antes el fallback escondia que la variable no estuviera
# surtiendo efecto.
PUBLIC_META_PIXEL_ID=1042412788159075

# Dominio publico de ESTE despliegue. Ademas del canonical y el og:image, ahora
# decide si el pixel carga: solo se inicializa cuando el hostname coincide.
# Definirla en Production Y en Preview por separado. En Preview conviene dejar
# PUBLIC_META_PIXEL_ID vacia para que los deploys de prueba no escriban en el
# dataset de produccion.
PUBLIC_SITE_URL=https://getapproved.jkamalcars.com

# Captcha: turnstile (por defecto), recaptcha o none.
PUBLIC_CAPTCHA_PROVIDER=turnstile
PUBLIC_TURNSTILE_SITE_KEY=
PUBLIC_RECAPTCHA_SITE_KEY=

PUBLIC_REQUIRE_COOKIE_CONSENT=true

# Solo si el formulario debe apuntar a otro endpoint. Por defecto /api/lead.
PUBLIC_LEAD_ENDPOINT=

# ---------------------------------------------------------------------------
# Privadas. Las lee la funcion en functions/api/lead.js, nunca el navegador.
# En Cloudflare Pages van marcadas como "Encrypt".
# ---------------------------------------------------------------------------

CRM_EMAIL=jkamalcars@leads.neoverify.com
MAIL_FROM=
MAIL_REPLY_TO=

RESEND_API_KEY=
MAILGUN_API_KEY=
MAILGUN_DOMAIN=

LEAD_FORWARD_URL=

# Origen del lead que Neo muestra como Referral Source / Source Detail.
# Para Meta: Facebook / Feyth Marketing. Para Google: cambiar a Google.
LEAD_SOURCE=Facebook
LEAD_SOURCE_DETAIL=Feyth Marketing

# provider/service del ADF. Vacio = se omite el tag. Noor mostro
# <service>Escalations</service> en su ejemplo; si es una cola de ruteo
# de Neo que necesitan, poner aqui ese valor. Si no, dejar vacio.
LEAD_SERVICE=

# Leads de prueba: abrir la landing con ?jk_test=1 y enviar el formulario.
# El ADF llega rotulado "TEST LEAD — marcar como DEAD" para que Neo lo distinga.
# No es una variable: es un parametro de URL. Se documenta aqui como recordatorio.

TURNSTILE_SECRET_KEY=
RECAPTCHA_SECRET_KEY=
CAPTCHA_MIN_SCORE=0.5

# Token de verificacion de dominio de Meta para ESTE dominio.
# Business Settings -> Brand Safety -> Domains, en el portafolio dueno del
# dataset. Cada dominio tiene el suyo: NO reutilizar el del otro proyecto.
# Vacio = no se renderiza la etiqueta.
PUBLIC_FB_DOMAIN_VERIFICATION=
