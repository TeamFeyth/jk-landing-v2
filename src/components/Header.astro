---
import Logo from './Logo.astro';
import { header } from '../data/copy';
import { site } from '../data/site';
---

<header class="header">
  <div class="container header__row">
    <Logo />

    <div class="header__actions">
      <span class="header__phone">
        <span class="header__phone-label">{header.phoneLabel}</span>
        <a class="header__phone-number" href={`tel:${site.phone.tel}`}>{site.phone.display}</a>
      </span>

      <a class="btn btn--secondary btn--sm header__inventory" href="#vehicles">{header.inventory}</a>
      <a class="btn btn--secondary btn--sm" href="#hero-form">{header.cta}</a>
    </div>
  </div>
</header>
