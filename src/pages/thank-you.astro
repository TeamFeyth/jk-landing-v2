---
import '@fontsource/archivo/400.css';
import '@fontsource/archivo/500.css';
import '@fontsource/archivo/600.css';
import '@fontsource/archivo/700.css';
import '@fontsource/archivo-black/400.css';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/components.css';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingCall from '../components/FloatingCall.astro';
import CookieConsent from '../components/CookieConsent.astro';
import MetaPixel from '../components/MetaPixel.astro';
import Icon from '../components/Icon.astro';

import { thankYou as copy, vehiclesSection } from '../data/copy';
import { site } from '../data/site';

const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    {
      /* El pixel de Meta vive SOLO en <MetaPixel />, al final del <body>.
         Esta pagina no usa Base.astro, asi que tenia su propia copia del
         snippet con el ID escrito a mano. Al quitarla, fbq ya no existe
         durante el parseo del <head>: el script que dispara el Lead, mas
         abajo, tiene un reintento para eso. */
    }
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{copy.title}</title>
    <meta name="description" content={copy.description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta name="robots" content="noindex, nofollow" />

    <link rel="preconnect" href="https://connect.facebook.net" crossorigin />
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <Header />

    <main id="main" class="section thanks">
      <div class="container">
        <div class="thanks__panel">
          <span class="thanks__check" aria-hidden="true">
            <Icon name="check" />
          </span>

          <p class="t-eyebrow thanks__eyebrow">{copy.eyebrow}</p>
          <h1 class="t-h1 thanks__heading">{copy.heading}</h1>
          <p class="t-body-lg thanks__body">{copy.body}</p>

          <a class="btn btn--primary btn--lg thanks__cta" href={`tel:${site.phone.tel}`}>
            {site.phone.display}
          </a>
        </div>

        <section class="thanks__next">
          <h2 class="t-h2 thanks__next-heading">{copy.next.heading}</h2>

          <div class="thanks__cards">
            <article class="card thanks__card">
              <h3 class="t-h3 thanks__card-title">{copy.next.items[0].title}</h3>
              <p class="thanks__card-body">{copy.next.items[0].body}</p>
              <a class="btn btn--secondary btn--md" href={site.links.inventory} rel="noopener">
                {vehiclesSection.viewAll}
              </a>
            </article>

            <article class="card thanks__card">
              <h3 class="t-h3 thanks__card-title">{copy.next.items[1].title}</h3>
              <p class="thanks__card-body">{copy.next.items[1].body}</p>
              <a class="btn btn--secondary btn--md" href={`tel:${site.phone.tel}`}>
                {copy.next.items[1].label}
              </a>
            </article>
          </div>

          <div class="thanks__hours">
            <h3 class="t-eyebrow thanks__hours-heading">{copy.hours}</h3>
            <dl>
              {site.hours.map((row) => (
                <div class="footer__hours">
                  <dt>{row.days}</dt>
                  <dd>{row.time}</dd>
                </div>
              ))}
            </dl>
          </div>
        </section>

        <p class="thanks__back">
          <a class="link" href="/">{copy.back}</a>
        </p>
      </div>
    </main>

    <Footer />
    <FloatingCall />
    <CookieConsent />
    <MetaPixel />
  </body>
</html>

<script>
  import { LEAD_EVENT_NAME } from '../data/site';

  const params = new URLSearchParams(window.location.search);
  const source = params.get('source') ?? 'unknown';
  const eventId = params.get('eid') ?? '';

  const ONCE_KEY = `jk_lead_fired_${eventId || source}`;

  function yaDisparado(): boolean {
    if (!eventId) return false;
    try {
      return sessionStorage.getItem(ONCE_KEY) === '1';
    } catch {
      return false;
    }
  }

  function marcar(): void {
    try {
      sessionStorage.setItem(ONCE_KEY, '1');
    } catch {
      return;
    }
  }

  // El eventID es el mismo que va en el ADF, para que la CAPI pueda deduplicar.
  // Recargar la pagina no vuelve a contarlo.
  function disparar(): boolean {
    if (yaDisparado()) return true;

    const fbq = window.fbq;
    if (typeof fbq !== 'function') return false;

    // Lead estandar: es contra el que optimizan las campanas y el que ya tiene
    // historico en el dataset. No se toca.
    //
    // LEAD_EVENT_NAME (lp2_lead) es el que identifica la landing. Las dos
    // landings mandan Lead al mismo dataset y antes solo se distinguian por el
    // path /thank-you o por el parametro source; Meta descarta las dos cosas
    // en datasets con restricciones de categoria, asi que las conversiones
    // personalizadas por URL dejaron de contar. El nombre del evento no es un
    // parametro de URL y si sobrevive.
    //
    // Va el mismo eventID en ambos a proposito: Meta deduplica por la pareja
    // (nombre de evento, eventID), asi que dos nombres distintos no se pisan.
    if (eventId) {
      fbq('track', 'Lead', { content_category: source }, { eventID: eventId });
      fbq('trackCustom', LEAD_EVENT_NAME, { content_category: source }, { eventID: eventId });
    } else {
      fbq('track', 'Lead', { content_category: source });
      fbq('trackCustom', LEAD_EVENT_NAME, { content_category: source });
    }

    marcar();
    return true;
  }

  if (!disparar()) {
    /* Antes el pixel se inicializaba de forma sincrona en el <head> de esta
       pagina, asi que fbq siempre existia para cuando corria este script y
       bastaba con escuchar el consentimiento. Ahora lo carga <MetaPixel />,
       que es un script de modulo y corre despues del parseo: si el usuario ya
       tenia el consentimiento dado, no habra ningun evento jk:consent que
       esperar y el Lead se perderia. De ahi el reintento. */
    let intentos = 0;
    const timer = window.setInterval(() => {
      if (disparar() || ++intentos >= 20) window.clearInterval(timer);
    }, 250);

    document.addEventListener('jk:consent', () => {
      if (disparar()) window.clearInterval(timer);
    });
  }
</script>
