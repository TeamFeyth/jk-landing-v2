---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import TrustStrip from '../components/TrustStrip.astro';
import FeaturedVehicles from '../components/FeaturedVehicles.astro';
import HowItWorks from '../components/HowItWorks.astro';
import ReviewsStrip from '../components/ReviewsStrip.astro';
import BottomBlock from '../components/BottomBlock.astro';
import Footer from '../components/Footer.astro';
import MobilePopup from '../components/MobilePopup.astro';
---

<Base>
  <Header />
  <main id="main">
    <Hero />
    <TrustStrip />
    <FeaturedVehicles />
    <HowItWorks />
    <ReviewsStrip />
    <BottomBlock />
  </main>
  <Footer />
  <MobilePopup />
</Base>
